# Copy to .env.local. Leave the Supabase pair empty to run the read-only demo.

# Supabase project → Settings → API. The anon/publishable key is safe in the
# browser: row-level security in supabase/migrations decides what it can read.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where sign-up and magic-link emails send people back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The Python engine (the repository root deployed on Vercel, or `carbonstack serve`)
# and the shared secret its /api/estimate route requires. Server-side only.
CARBONSTACK_ENGINE_URL=
CARBONSTACK_ENGINE_TOKEN=

# Optional: rename the product.
# NEXT_PUBLIC_APP_NAME=Carbonstack
